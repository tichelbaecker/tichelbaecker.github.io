---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
  </header>

  <article>
    {{ page.intro | markdownify }}

    <div class="research-areas">
      {% for area in page.areas %}
        <button class="research-card{% if forloop.first %} active{% endif %}" data-area="{{ area.id }}" onclick="showArea('{{ area.id }}')">
          <div class="research-card-icon">
            <i class="{{ area.icon }}"></i>
          </div>
          <h3>{{ area.title }}</h3>
          <p>{{ area.summary }}</p>
        </button>
      {% endfor %}
    </div>

    {% for area in page.areas %}
      <div class="research-section{% if forloop.first %} active{% endif %}" id="area-{{ area.id }}">
        {% for q in area.questions %}
          <div class="cornell-row">
            <aside class="cornell-margin">{{ q.question }}</aside>
            <div class="cornell-content">{{ q.answer | markdownify }}</div>
          </div>
        {% endfor %}
        <div class="research-publications">
          <h3 class="relevant-work-header">Relevant work</h3>
          {% bibliography --query @*[keywords={{ area.id }}] --template bib-research %}
        </div>
      </div>
    {% endfor %}
  </article>
</div>

<script>
function showArea(area) {
  document.querySelectorAll('.research-section').forEach(function(el) {
    el.classList.remove('active');
  });
  document.querySelectorAll('.research-card').forEach(function(el) {
    el.classList.remove('active');
  });
  document.getElementById('area-' + area).classList.add('active');
  document.querySelector('.research-card[data-area="' + area + '"]').classList.add('active');
  document.querySelector('.post').setAttribute('data-active-area', area);
}

(function() {
  var params = new URLSearchParams(window.location.search);
  var area = params.get('area');
  if (area && document.getElementById('area-' + area)) {
    showArea(area);
  } else {
    document.querySelector('.post').setAttribute('data-active-area', '{{ page.areas[0].id }}');
  }
})();
</script>

<style>
  .research-areas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .research-areas { grid-template-columns: 1fr; }
  }

  {% for area in page.areas %}
  .post[data-active-area="{{ area.id }}"] { --global-theme-color: {{ area.color }}; --area-color: {{ area.color }}; }
  html[data-theme="dark"] .post[data-active-area="{{ area.id }}"] { --global-theme-color: {{ area.color_dark }}; --area-color: {{ area.color_dark }}; }
  .research-card[data-area="{{ area.id }}"] { --card-color: {{ area.color }}; background-color: color-mix(in srgb, {{ area.color }} 10%, var(--global-bg-color)); }
  {% endfor %}

  .research-card {
    display: block;
    text-align: left;
    padding: 1.5rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    text-decoration: none;
    color: var(--global-text-color);
    background-color: transparent;
    cursor: pointer;
    opacity: 0.55;
    position: relative;
    overflow: hidden;
  }

  .research-card:hover {
    opacity: 0.85;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .research-card.active {
    border-color: var(--card-color);
    background-color: color-mix(in srgb, var(--card-color) 15%, var(--global-bg-color));
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    opacity: 1;
  }

  .research-card-icon {
    font-size: 1.5rem;
    color: var(--card-color, var(--global-theme-color));
    margin-bottom: 0.75rem;
  }

  .research-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--global-text-color);
  }

  .research-card p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--global-text-color-light);
    margin-bottom: 0;
  }

  html.transition .research-card,
  html.transition .research-card *,
  html.transition .research-card *:before,
  html.transition .research-card *:after {
    transition: none !important;
  }

  .research-section {
    display: none;
    animation: fadeIn 0.3s ease;
  }

  .research-section.active {
    display: block;
    background: color-mix(in srgb, var(--area-color) 10%, transparent);
    border-radius: 12px;
    padding: 1.5rem 2rem;
    box-shadow: 0 0 15px 5px color-mix(in srgb, var(--area-color) 20%, transparent);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .research-publications {
    margin-top: 2rem;
  }

  .research-publications .relevant-work-header {
    display: block !important;
    border-top: 2px solid color-mix(in srgb, var(--area-color) 30%, transparent);
    padding-top: 1rem;
    margin-bottom: 1.25rem;
    color: var(--area-color);
    font-weight: 500;
    font-size: 1.2rem;
  }

  .research-publications h2.bibliography,
  .research-publications h3.bibliography { display: none; }

  .research-publications ol {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }

  .research-publications ol li {
    margin-bottom: 0.75rem;
    padding-left: 1rem;
    position: relative;
  }

  .research-publications ol li::before {
    content: "\2022";
    color: var(--area-color);
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  .research-pub-entry .title {
    font-weight: 500;
  }

  .research-pub-entry .title a {
    color: var(--global-text-color);
    text-decoration: none;
  }

  .research-pub-entry .title a:hover {
    color: var(--area-color);
  }

  .research-pub-entry .author {
    font-size: 0.9rem;
  }

  .research-pub-entry .periodical {
    font-size: 0.9rem;
    color: var(--global-text-color-light);
  }

  .research-pub-entry .working-paper {
    font-style: italic;
  }

  .cornell-row {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 1.5rem;
    margin-bottom: 0.25rem;
    align-items: start;
  }

  .cornell-margin {
    font-size: 0.8rem;
    font-style: italic;
    line-height: 1.4;
    color: var(--area-color);
    padding-right: 1rem;
    padding-top: 0.15rem;
    border-right: 2px solid color-mix(in srgb, var(--area-color) 30%, transparent);
  }

  .cornell-content { min-width: 0; }
  .cornell-content p { margin-bottom: 0; }

  @media (max-width: 768px) {
    .cornell-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      margin-bottom: 1rem;
    }

    .cornell-margin {
      border-right: none;
      border-left: 2px solid color-mix(in srgb, var(--area-color) 30%, transparent);
      padding-right: 0;
      padding-left: 0.75rem;
    }
  }
</style>
